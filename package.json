{
  "name": "dsh-virtuoso-bridge",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Virtuoso Bridge for DeepSeek Harness: managed virtuoso-bridge-lite runtimes, fixed or automatic-session daemon discovery, an isolated Python environment, agent tools, a left-sidebar configuration page and a right-sidebar runtime panel.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "lib/*.js",
    "runtime/*.py",
    "vendor/**"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  }
}
